# Токен бота от @BotFather
BOT_TOKEN=123456789:AAF...your...token

# Прокси для доступа к api.telegram.org — нужен, если VPS не может обращаться
# к Telegram напрямую (бот падает с TelegramNetworkError: Request timeout error).
# Форматы: socks5://user:pass@host:port, socks4://host:port, http://host:port
# Пример для прокси на самом сервере: socks5://host.docker.internal:1080
# Пусто — прямое подключение
TG_PROXY_URL=

# Подключения (внутри docker-compose; для локального запуска без docker замените хосты на localhost)
DATABASE_URL=postgresql+asyncpg://gsm:gsm@db:5432/gsm
REDIS_URL=redis://redis:6379/0

# Telegram ID администраторов (= менеджеров) через запятую:
# им доступна /admin и им приходят заявки с кнопкой «Обработана»
ADMIN_IDS=1,2,3

# Напоминания о незавершённой заявке
REMINDER_DELAY_MINUTES=60
REMINDER_MAX_COUNT=1

# Ссылка на Telegram-канал (кнопка «Подписаться» в ветке партнёрской программы
# и в заглушке для неподписанных)
CHANNEL_URL=https://t.me/your_channel

# ID канала для проверки подписки (вида -1001234567890): без подписки бот
# не отвечает пользователю. Бот должен быть АДМИНОМ канала. Пусто — без проверки.
TELEGRAM_CHANNEL_ID=

# Postgres (для контейнера db)
POSTGRES_USER=gsm
POSTGRES_PASSWORD=gsm
POSTGRES_DB=gsm

# Авито: официальное Messenger API (developers.avito.ru). Пусто — интеграция
# выключена, поллинг-задача завершается без действий. Для товаров мессенджер-API
# доступен на тарифе «Максимальный», для услуг — с «Расширенного».
AVITO_CLIENT_ID=
AVITO_CLIENT_SECRET=
# Номер профиля Авито (виден в ссылке на профиль)
AVITO_USER_ID=

# Groq: AI-автоответы клиентам Авито (console.groq.com → API Keys).
# Пусто — ассистент выключен, клиенту уходит шаблонный автоответ.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Прокси для api.groq.com, если он недоступен с VPS (формат как TG_PROXY_URL)
GROQ_PROXY_URL=
